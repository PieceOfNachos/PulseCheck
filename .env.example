# ── General ──
NODE_ENV=development

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/pulsecheck

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ── Service Ports ──
AUTH_PORT=3001
MONITORING_PORT=3002
NOTIFICATION_PORT=3003

# ── SMTP (Nodemailer) ──
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pulsecheck.dev
